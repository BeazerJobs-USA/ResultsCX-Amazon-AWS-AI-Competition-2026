# Example only. Do not put real credentials or account-specific runtime ARNs in Git.
# Use an approved local AWS profile, SSO/IAM Identity Center, or assumed role.
AWS_PROFILE=your-approved-profile
AWS_DEFAULT_REGION=us-east-1

# Bedrock AgentCore runtime ARN (named HARNESS_ARN in this team's workflow).
# Exact naming may differ when the original source is released.
HARNESS_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT:runtime/APPROVED-RUNTIME

# Do not add AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or AWS_SESSION_TOKEN here.
