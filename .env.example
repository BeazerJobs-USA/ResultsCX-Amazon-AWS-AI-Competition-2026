# The public walkthrough uses invented data and does not need AWS credentials.
QA_DATA_SOURCE=synthetic

# Only needed for an authorized Bedrock AgentCore InvokeHarness call.
AWS_PROFILE=your-approved-profile
AWS_DEFAULT_REGION=us-east-1
HARNESS_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT:harness/approved_harness-ABCDEFGHIJ
HARNESS_MAX_TOKENS=8000

# Private data is disabled by default. See docs/SECURITY.md before enabling.
# QA_DATA_SOURCE=private
# ALLOW_PRIVATE_QA_READ=1
# ALLOW_PRIVATE_CLOUD_SEND=1
# ALLOW_PRIVATE_OUTPUT_STORAGE=1

# Do not put AWS access keys or tokens in this file or Git history.
